# Everything is local by default. Nothing here is required.
PROVIDER=ollama                 # ollama | anthropic | gemini | openai  (who writes the answers)
MODEL=                          # empty = default for the provider (qwen3:4b-instruct for ollama)
AGENT_PROVIDER=ollama           # ollama | anthropic | openai-compatible
AGENT_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
ALLOW_REMOTE_OLLAMA=0           # set to 1 only if OLLAMA_HOST is your own server on your network
EMBED_MODEL=nomic-embed-text
DOCS_DIR=samples/docs
INDEX_PATH=data/index.sqlite
COMPANY_NAME=Hayashi Seiko Works
TOP_K=5
MIN_SCORE=0.35
NUM_CTX=8192
# Cloud keys: only for a cloud PROVIDER. On macOS they can live in the Keychain instead
# (items anthropic-api-key, gemini-api-key, openai-api-key).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
SCREEN_PASSAGES=1              # 0 = do not flag passages that address the AI (not recommended)
